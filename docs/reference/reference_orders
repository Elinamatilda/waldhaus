<!-- Interactive Filter Script -->
<script>
    function filterOrders(status) {
      const buttons = document.querySelectorAll('.tab-btn');
      buttons.forEach(btn => {
        if (btn.getAttribute('data-target') === status) {
          btn.className = "tab-btn px-space-md py-2 rounded-lg text-label-lg font-label-lg bg-surface text-on-surface shadow-sm transition-all";
        } else {
          btn.className = "tab-btn px-space-md py-2 rounded-lg text-label-lg font-label-lg text-on-surface-variant hover:text-on-surface transition-all";
        }
      });

      const rows = document.querySelectorAll('.order-row');
      rows.forEach(row => {
        if (status === 'all' || row.getAttribute('data-status') === status) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }
  </script>
